DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_TIMEOUT_SECONDS=120

SOTA_API_KEY=your_relay_api_key_here
SOTA_BASE_URL=https://api.relayrouter.ai/v1
SOTA_TIMEOUT_SECONDS=120

LOG_LEVEL=INFO
SHOW_EVALUATION_CONTROLS=false
ENABLE_DEBUG_MODE=false
DATABASE_PATH=data/writing_assistant_v3.db
SMALL_CHANGE_TOKEN_THRESHOLD=8
